{
  "name": "gtav-mobile-diagnostics",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "1352026101501", "simple": { "limit": 3, "period": 60 } },
    { "name": "GLOBAL_LIMIT", "namespace_id": "1352026101502", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
