    "Cheats may be unavailable during missions. They temporarily disable achievements; reload a save or restart the game to reset them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheats may be unavailable during missions. They temporarily disable achievements; reload a save or restart the game to reset them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevler sırasında bazı hileler kullanılamayabilir. Hileler başarımları geçici olarak devre dışı bırakır; sıfırlamak için bir kaydı yeniden yükleyin veya oyunu yeniden başlatın."
          }
        }
      }
    },
    "Names and instructions follow the app language. Codes stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and instructions follow the app language. Codes stay unchanged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlar ve açıklamalar uygulama diline göre gösterilir. Kodlar aynı kalır."
          }
        }
      }
    },
    "This is a reference, not an activation button. Enter the phone number on the character's in-game phone, or enter the PC code with a physical keyboard if this game build supports the cheat console. Copying a code does not activate it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference, not an activation button. Enter the phone number on the character's in-game phone, or enter the PC code with a physical keyboard if this game build supports the cheat console. Copying a code does not activate it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir rehberdir. Hileyi kullanmak için numarayı karakterin oyun içindeki telefonunda tuşlayın veya bu oyun sürümü hile konsolunu destekliyorsa PC kodunu fiziksel klavyeyle girin. Kodu kopyalamak hileyi etkinleştirmez."
          }
        }
      }
    },
    "Show code and copy options": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show code and copy options"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu ve kopyalama seçeneklerini göster"
          }
        }
      }
    },
    "%@\n\nPC code: %@\nIn-game phone: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nPC code: %@\nIn-game phone: %@"
