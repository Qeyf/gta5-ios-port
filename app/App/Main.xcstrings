          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki oyun açılışı tamamlanmadı. Grafikler %@ ve çözünürlük Otomatik olarak ayarlandı. Ayarlar’dan değiştirebilir veya sorunu incelememize yardımcı olmak için günlüğü paylaşabilirsin."
          }
        }
      }
    },
