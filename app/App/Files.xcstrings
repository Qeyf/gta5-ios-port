            "state": "translated",
            "value": "Dosya boş."
          }
        }
      }
    },
    "The file is not at that link (HTTP %lld). The link is wrong or the file was removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is not at that link (HTTP %lld). The link is wrong or the file was removed."
          }
