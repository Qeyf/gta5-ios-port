          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm sorunları göster"
          }
        }
      }
    },
    "Simulator uses its app container for engine files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator uses its app container for engine files."
          }
