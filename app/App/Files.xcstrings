          }
        }
      }
    },
    "\"%@\" in the GtaV Mobile folder: all %@ game files checked (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" in the GtaV Mobile folder: all %@ game files checked (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” klasörü GtaV Mobile klasöründe: %@ oyun dosyasının tamamı denetlendi (%@)."
          }
        }
      }
    },
    "\"%@\" on this iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" on this iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” bu iPhone’da."
          }
        }
      }
    },
    "\"%@\" on this iPhone: all %@ game files checked (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" on this iPhone: all %@ game files checked (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’daki “%@” klasörü: %@ oyun dosyasının tamamı denetlendi (%@)."
          }
        }
      }
    },
    "%@\n\nEvery problem:\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nEvery problem:\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nTüm sorunlar:\n%@"
          }
        }
      }
    },
    "%@ answers with the game's file list. The game reads its files from there while you play.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ answers with the game's file list. The game reads its files from there while you play."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oyunun dosya listesini sağlıyor. Oyun, oynarken dosyalarını buradan okur."
          }
        }
      }
    },
    "%@ files are missing (%@ in all), for example %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ files are missing (%@ in all), for example %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosya eksik (toplam %@); örneğin %@."
          }
        }
      }
    },
    "%@ files are only in iCloud, not on this iPhone (for example %@). The game can't read them from there: move the game folder to Files › On My iPhone › GtaV Mobile.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ files are only in iCloud, not on this iPhone (for example %@). The game can't read them from there: move the game folder to Files › On My iPhone › GtaV Mobile."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosya yalnızca iCloud’da; bu iPhone’da bulunmuyor (örneğin %@). Oyun, bu dosyaları iCloud’dan okuyamaz. Oyun klasörünü Dosyalar › iPhone’umda › GtaV Mobile içine taşıyın."
          }
        }
      }
    },
    "%@ files have the wrong size, for example %@ (%@ instead of %@). These files are damaged, usually by an interrupted download or unpack, or come from a different version of the game. Delete the folder and unpack the game again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ files have the wrong size, for example %@ (%@ instead of %@). These files are damaged, usually by an interrupted download or unpack, or come from a different version of the game. Delete the folder and unpack the game again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dosyanın boyutu yanlış; örneğin %2$@ (%4$@ yerine %3$@). Bu dosyalar, genellikle indirme veya arşivden çıkarma işlemi kesildiği için bozulmuştur ya da oyunun farklı bir sürümüne aittir. Klasörü silin ve oyun arşivini yeniden açın."
          }
        }
      }
    },
    "%@ game files are missing (e.g. %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ game files are missing (e.g. %@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oyun dosyası eksik (ör. %@)"
          }
        }
      }
    },
    "%@ game files have the wrong size (e.g. %@)": {
      "localizations": {
