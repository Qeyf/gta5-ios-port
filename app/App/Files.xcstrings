            "value": "Yükleme iptal edildi."
          }
        }
      }
    },
    "The internet connection was lost and did not come back for %@. Check your connection and start again; what was unpacked so far is kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The internet connection was lost and did not come back for %@. Check your connection and start again; what was unpacked so far is kept."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet bağlantısı kesildi ve %@ boyunca yeniden kurulamadı. Bağlantınızı kontrol edin ve yeniden başlayın; şimdiye kadar çıkarılan dosyalar korunur."
          }
        }
      }
    },
    "The link could not be opened: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link could not be opened: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı açılamadı: %@"
          }
        }
      }
    },
    "The link did not answer like a web server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link did not answer like a web server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıdan geçerli bir web sunucusu yanıtı alınamadı."
          }
        }
      }
    },
    "The link must start with http:// or https:// (got \"%@\").": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link must start with http:// or https:// (got \"%@\")."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı http:// veya https:// ile başlamalıdır (girilen: “%@”)."
          }
        }
      }
    },
    "The link opens a web page, not the game file. On the download site, copy the address of the actual download (often behind a \"Download\" button), not the page's address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link opens a web page, not the game file. On the download site, copy the address of the actual download (often behind a \"Download\" button), not the page's address."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı oyun dosyasına değil, bir web sayfasına açılıyor. İndirme sitesinde sayfanın adresi yerine asıl indirme bağlantısını kopyalayın (genellikle “İndir” düğmesindedir)."
          }
        }
      }
    },
    "The link redirects somewhere that could not be followed (HTTP %lld).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link redirects somewhere that could not be followed (HTTP %lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı, takip edilemeyen bir adrese yönlendiriyor (HTTP %lld)."
          }
        }
      }
    },
    "The server answered with an error (HTTP %lld).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered with an error (HTTP %lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu hata yanıtı verdi (HTTP %lld)."
          }
        }
      }
    },
    "The server could not accept the log: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not accept the log: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu günlüğü kabul edemedi: %@"
          }
        }
      }
    },
    "The server had a problem (HTTP %lld). This is on the server's side; try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server had a problem (HTTP %lld). This is on the server's side; try again later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuda bir sorun oluştu (HTTP %lld). Sorun sunucu tarafında; daha sonra yeniden deneyin."
          }
        }
      }
    },
    "The server refused to give out the file (HTTP %lld). The link may have expired, need a login, or only work in a browser. Get a fresh link and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused to give out the file (HTTP %lld). The link may have expired, need a login, or only work in a browser. Get a fresh link and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu dosyayı vermeyi reddetti (HTTP %lld). Bağlantının süresi dolmuş olabilir, oturum açmak gerekebilir veya bağlantı yalnızca tarayıcıda çalışıyor olabilir. Yeni bir bağlantı edinin ve yeniden deneyin."
          }
        }
      }
    },
    "The server says too many downloads were started (HTTP 429). Wait a while and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server says too many downloads were started (HTTP 429). Wait a while and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu, çok fazla indirme başlatıldığını bildiriyor (HTTP 429). Bir süre bekleyin ve yeniden deneyin."
          }
        }
      }
    },
    "The server sent the wrong part of the file when resuming.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sent the wrong part of the file when resuming."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam edilirken sunucu dosyanın yanlış bölümünü gönderdi."
          }
        }
      }
    },
    "The simulator reads the Mac's game files directly. Launch with --stream-assets to test downloads.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The simulator reads the Mac's game files directly. Launch with --stream-assets to test downloads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simülatör, Mac’teki oyun dosyalarını doğrudan okur. İndirmeleri sınamak için --stream-assets ile başlatın."
          }
        }
      }
    },
    "There is no game in \"%@\". Pick the folder that has your game in it (any folder above it works, even On My iPhone itself).\n\nEasiest: move your game folder into Files › On My iPhone › GtaV Mobile. The app finds it there by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no game in \"%@\". Pick the folder that has your game in it (any folder above it works, even On My iPhone itself).\n\nEasiest: move your game folder into Files › On My iPhone › GtaV Mobile. The app finds it there by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” içinde oyun yok. Oyununuzu içeren klasörü seçin (oyunun üstündeki herhangi bir klasör, hatta iPhone’umda konumu kullanılabilir).\n\nEn kolay yol: oyun klasörünüzü Dosyalar › iPhone’umda › GtaV Mobile içine taşıyın. Uygulama oyunu burada otomatik olarak bulur."
          }
        }
      }
    },
    "This file is not an archive the installer can open. Supported: zip, rar, rar5, tar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is not an archive the installer can open. Supported: zip, rar, rar5, tar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya, yükleyicinin açabileceği bir arşiv değil. Desteklenen biçimler: zip, rar, rar5, tar."
          }
        }
      }
    },
    "This folder has none of the game's files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder has none of the game's files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörde oyunun hiçbir dosyası yok."
          }
        }
      }
    },
    "This is a web page, not the game archive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a web page, not the game archive."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya oyun arşivi değil, bir web sayfası."
          }
        }
      }
    },
    "To fit on this iPhone, the archive is used up while it unpacks: once it's done, only the unpacked game is left. If unpacking stops half way, you'll need the archive again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To fit on this iPhone, the archive is used up while it unpacks: once it's done, only the unpacked game is left. If unpacking stops half way, you'll need the archive again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’daki alana sığması için dosyalar çıkarıldıkça arşivin okunan bölümleri silinir. İşlem bittiğinde yalnızca çıkarılan oyun dosyaları kalır. İşlem yarıda durursa arşivi yeniden edinmeniz gerekir."
          }
        }
      }
    },
    "Try again later, or use Share log instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again later, or use Share log instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra yeniden deneyin veya Günlüğü paylaş seçeneğini kullanın."
          }
        }
      }
    },
    "Try choosing it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try choosing it again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörü yeniden seçmeyi deneyin."
          }
        }
      }
    },
    "Unpack": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpack"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivi aç"
          }
        }
      }
    },
    "Unpack %@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpack %@ (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arşivini aç (%@)"
          }
        }
      }
    },
    "Unpack %@?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpack %@?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arşivi açılsın mı?"
          }
        }
      }
    },
    "Unpacking or copying probably stopped before the end, most often because the iPhone ran out of storage. Free up space, delete this folder and unpack the game again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpacking or copying probably stopped before the end, most often because the iPhone ran out of storage. Free up space, delete this folder and unpack the game again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivden çıkarma veya kopyalama işlemi muhtemelen tamamlanmadan durdu. Bunun en yaygın nedeni, iPhone’da boş alan kalmamasıdır. Yer açın, bu klasörü silin ve oyun arşivini yeniden açın."
          }
        }
      }
    },
    "Unpacking… %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpacking… %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivden çıkarılıyor… %@"
          }
        }
      }
    },
    "Use one of the ways below. Whichever you choose, the app checks every file before you play.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one of the ways below. Whichever you choose, the app checks every file before you play."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki yöntemlerden birini kullanın. Hangi yöntemi seçerseniz seçin, uygulama oynamadan önce her dosyayı denetler."
          }
        }
      }
    },
    "Use the page's download button in the browser; the app takes over the download.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the page's download button in the browser; the app takes over the download."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıda sayfanın indirme düğmesini kullanın. Uygulama indirmeyi devralır."
          }
        }
      }
    },
    "What happened? (optional)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happened? (optional)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne oldu? (isteğe bağlı)"
          }
        }
      }
    },
    "Writing %@ failed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing %@ failed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yazılamadı."
          }
        }
      }
    },
    "You chose to play anyway. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose to play anyway. %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine de oynamayı seçtiniz. %@"
          }
        }
      }
    },
    "You chose to play anyway. The game may crash where it needs them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose to play anyway. The game may crash where it needs them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine de oynamayı seçtiniz. Oyun, bu dosyalara ihtiyaç duyduğunda çökebilir."
          }
        }
      }
    },
    "You opened the \"%@\" folder. Go back up one or two levels and pick the folder that has both \"data\" and \"b\" inside, then tap Open there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened the \"%@\" folder. Go back up one or two levels and pick the folder that has both \"data\" and \"b\" inside, then tap Open there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” klasörünü açtınız. Bir veya iki üst düzeye dönün, içinde hem “data” hem de “b” bulunan klasörü seçin ve Aç’a dokunun."
          }
        }
      }
    },
    "about %@ left": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "about %@ left"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yaklaşık %@ kaldı"
          }
        }
      }
    },
    "folder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "folder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "klasör"
          }
        }
      }
    },
    "missing: %@ (%@ bytes)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "missing: %@ (%@ bytes)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "eksik: %@ (%@ bayt)"
          }
        }
      }
    },
    "only in iCloud: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "only in iCloud: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yalnızca iCloud’da: %@"
          }
        }
      }
    },
    "the game (%@) next to the archive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the game (%@) next to the archive"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "arşivin yanında oyun için gerekli alan (%@)"
          }
        }
      }
    },
    "the game (%@) plus up to %@ of download buffer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the game (%@) plus up to %@ of download buffer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "oyun (%@) ve en fazla %@ indirme arabelleği"
          }
        }
      }
    },
    "the game minus the archive it replaces as it unpacks (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the game minus the archive it replaces as it unpacks (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "arşivden çıkarma sırasında silinen arşivin yerine geçen oyunun ek alan ihtiyacı (%@)"
          }
        }
      }
    },
    "the last part": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the last part"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "son parça"
          }
        }
      }
    },
    "under a minute left": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "under a minute left"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bir dakikadan az kaldı"
          }
        }
      }
    },
    "wrong size: %@ is %@ bytes, expected %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "wrong size: %@ is %@ bytes, expected %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yanlış boyut: %1$@, %3$@ yerine %2$@ bayt"
          }
        }
      }
    },
    "Go back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri dön"
          }
        }
      }
    }
  },
  "version": "1.0"
}
