        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli boş depolama alanı yok. Yükleme için %@ boş alan gerekir (%@ ve buna ek olarak %@ boş alan). Kullanılabilir alan yalnızca %@. %@ daha yer açın ve yeniden deneyin."
          }
        }
      }
    },
