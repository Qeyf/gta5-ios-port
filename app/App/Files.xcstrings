    },
    "The app could not remember that folder: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app could not remember that folder: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bu klasörü kaydedemedi: %@"
          }
        }
      }
    },
    "The app looked through every folder in On My iPhone › GtaV Mobile and found no game. If your game is somewhere else (another folder, or another app's folder), tap Choose a folder… below and pick it, or pick On My iPhone itself to search everything. iOS only lets an app into other folders once you pick them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app looked through every folder in On My iPhone › GtaV Mobile and found no game. If your game is somewhere else (another folder, or another app's folder), tap Choose a folder… below and pick it, or pick On My iPhone itself to search everything. iOS only lets an app into other folders once you pick them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, iPhone’umda › GtaV Mobile içindeki tüm klasörleri aradı, ancak oyun bulamadı. Oyununuz başka bir yerdeyse (başka bir klasörde veya başka bir uygulamanın klasöründe), aşağıdaki Klasör seç… düğmesine dokunarak o klasörü seçin. Her yerde aramak için iPhone’umda konumunu da seçebilirsiniz. iOS, diğer klasörlere ancak siz seçtikten sonra erişim sağlar."
          }
        }
      }
    },
    "The app was not allowed to open that folder. Move your game folder to Files › On My iPhone › GtaV Mobile instead; the app finds it there by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was not allowed to open that folder. Move your game folder to Files › On My iPhone › GtaV Mobile instead; the app finds it there by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın bu klasörü açmasına izin verilmedi. Oyun klasörünüzü Dosyalar › iPhone’umda › GtaV Mobile içine taşıyın; uygulama oyunu burada otomatik olarak bulur."
          }
        }
      }
    },
    "The app's game file list (manifest.json) is empty.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's game file list (manifest.json) is empty."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın oyun dosyası listesi (manifest.json) boş."
          }
        }
      }
    },
    "The app's game file list (manifest.json) is missing or damaged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's game file list (manifest.json) is missing or damaged."
          }
        },
        "tr": {
