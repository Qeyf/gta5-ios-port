    "7-Zip (.7z) archives are not supported. Re-pack the game as a zip or rar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7-Zip (.7z) archives are not supported. Re-pack the game as a zip or rar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7-Zip (.7z) arşivleri desteklenmiyor. Oyunu zip veya rar olarak yeniden arşivleyin."
          }
        }
      }
    },
    "A download page where you tap Download first works too: it opens here in a browser, and the app takes the download over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A download page where you tap Download first works too: it opens here in a browser, and the app takes the download over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce İndir düğmesine dokunmanız gereken bir indirme sayfası da kullanılabilir. Sayfa burada bir tarayıcıda açılır ve uygulama indirmeyi devralır."
          }
        }
      }
    },
    "A downloaded chunk could not be opened.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A downloaded chunk could not be opened."
