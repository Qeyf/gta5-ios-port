          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı oyun dosyaları eksik"
          }
        }
      }
    },
    "Somewhere else? Choose any folder above it, even On My iPhone itself, and the app searches everything inside.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somewhere else? Choose any folder above it, even On My iPhone itself, and the app searches everything inside."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir yerde mi? Oyunun üstündeki herhangi bir klasörü, hatta iPhone’umda konumunu seçin. Uygulama içindeki her şeyi arar."
          }
        }
      }
    },
    "Start the game once, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the game once, then try again."
