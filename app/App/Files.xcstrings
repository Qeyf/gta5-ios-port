    },
    "The download folder could not be created.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download folder could not be created."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme klasörü oluşturulamadı."
          }
        }
      }
    },
    "The file is empty.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
