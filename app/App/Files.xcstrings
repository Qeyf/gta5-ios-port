          "stringUnit": {
            "state": "translated",
            "value": "İndirilen bir veri parçası açılamadı."
          }
        }
      }
    },
    "A part of the multi-part archive is missing or out of order. Make sure all parts are there and come from the same set.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A part of the multi-part archive is missing or out of order. Make sure all parts are there and come from the same set."
