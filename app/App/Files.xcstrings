      }
    },
    "Not enough free space. The rest of the game needs %@ plus %@ to spare, but only %@ is free. Free up %@ and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free space. The rest of the game needs %@ plus %@ to spare, but only %@ is free. Free up %@ and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli boş alan yok. Oyunun kalan kısmı için %@ ve buna ek olarak %@ boş alan gerekir. Kullanılabilir alan yalnızca %@. %@ yer açın ve yeniden deneyin."
          }
        }
      }
    },
    "Not enough free storage. Installing needs %@ free (%@, plus %@ to spare), but only %@ is free. Free up %@ more and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free storage. Installing needs %@ free (%@, plus %@ to spare), but only %@ is free. Free up %@ more and try again."
