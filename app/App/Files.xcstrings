            "state": "translated",
            "value": "Dosya bu bağlantıda bulunamadı (HTTP %lld). Bağlantı yanlış veya dosya kaldırılmış."
          }
        }
      }
    },
    "The file on the server changed while it was downloading. Start the install again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file on the server changed while it was downloading. Start the install again."
          }
        },
