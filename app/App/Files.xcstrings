            "state": "translated",
            "value": "İndirme sırasında sunucudaki dosya değişti. Yüklemeyi yeniden başlatın."
          }
        }
      }
    },
    "The files could not be removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files could not be removed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar silinemedi."
          }
        }
      }
    },
    "The game files are already on this iPhone (folder \"%@\"), so nothing needs downloading.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game files are already on this iPhone (folder \"%@\"), so nothing needs downloading."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun dosyaları bu iPhone’da zaten mevcut (“%@” klasöründe). İndirilmesi gereken bir dosya yok."
          }
        }
      }
    },
    "The game folder could not be created.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game folder could not be created."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun klasörü oluşturulamadı."
          }
        }
      }
    },
    "The game starts, but it may crash or show missing things wherever it needs those files. Fixing the folder (unpacking again) is the real cure.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game starts, but it may crash or show missing things wherever it needs those files. Fixing the folder (unpacking again) is the real cure."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun başlar, ancak bu dosyalara ihtiyaç duyduğunda çökebilir veya bazı içerikleri eksik gösterebilir. Kalıcı çözüm, arşivi yeniden açarak klasörü düzeltmektir."
          }
        }
      }
    },
    "The install failed: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The install failed: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme başarısız oldu: %@"
          }
        }
      }
    },
