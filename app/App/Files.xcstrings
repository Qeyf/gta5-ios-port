        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok parçalı arşivin bir parçası eksik veya yanlış sırada. Tüm parçaların mevcut olduğundan ve aynı arşive ait olduğundan emin olun."
          }
        }
      }
    },
