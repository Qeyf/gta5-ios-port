    },
    "Controls act as a game controller, so the game's own aim assist and analog steering work. Assisted aim locks onto targets like on a console.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls act as a game controller, so the game's own aim assist and analog steering work. Assisted aim locks onto targets like on a console."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokunmatik kontroller oyun kumandası gibi çalışır; böylece oyunun kendi nişan desteği ve analog direksiyonu kullanılabilir. Destekli nişan, konsollarda olduğu gibi hedeflere kilitlenir."
          }
        }
      }
    },
