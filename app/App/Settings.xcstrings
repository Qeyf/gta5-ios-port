    "Change the app language in iOS Settings. Tap App language, then choose your preferred language in this app's settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the app language in iOS Settings. Tap App language, then choose your preferred language in this app's settings."
