        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama dilini iOS Ayarları'ndan değiştirebilirsiniz. Uygulama dili satırına dokunun, ardından bu uygulamanın ayarlarından tercih ettiğiniz dili seçin."
          }
        }
      }
    },
